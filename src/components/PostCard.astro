---
import type { Post } from '../utils/posts';
import { postSlug, readingTime, wordCount, formatDate } from '../utils/posts';
import { u } from '../utils/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const slug = postSlug(post);
---

<li class="reveal">
  <a class="post-card" href={u(`/writing/${slug}/`)}>
    <div class="meta">
      <span>{formatDate(post.data.date)}</span>
      <span>{readingTime(post.body ?? '')} min read</span>
      <span>{wordCount(post.body ?? '')} words</span>
    </div>
    <h2>{post.data.title}</h2>
    <p class="desc">{post.data.description}</p>
    <span class="tag-row">
      {post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}
    </span>
  </a>
</li>
