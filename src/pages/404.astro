---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../utils/url';
---

<BaseLayout title="404" description="This page was misprinted.">
  <div class="container notfound">
    <p class="mono">Error — misprint</p>
    <p class="big">404</p>
    <h1>This page was misprinted.</h1>
    <p>
      The drum slipped and this one came out blank. <a href={u('/')}>Back to the cover</a> or
      <a href={u('/writing/')}>read the writing</a> instead.
    </p>
  </div>
</BaseLayout>
