---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import StampBadge from '../components/StampBadge.astro';
import Sticker from '../components/Sticker.astro';
import Ticker from '../components/Ticker.astro';
import Doodles from '../components/Doodles.astro';

const rows = [
  { href: '/writing/', label: 'Writing', hint: 'essays, notes, rants' },
  { href: '/about/', label: 'About', hint: 'who is this guy' },
  { href: '/now/', label: 'Now', hint: "what I'm up to" },
];
---

<BaseLayout title="Home">
  <div class="container cover">
    <Masthead text="JOE ROURKE" />
    <div class="cover-badges">
      <StampBadge lines={['ISSUE No. 001', 'EST. 2026']} />
      <Sticker tilt={2.5} bg="var(--orange)">100% hand-set</Sticker>
      <Sticker tilt={-2}>No trackers</Sticker>
    </div>
    <h2 class="cover-headline misreg" data-text="The web, but photocopied.">
      The web, but photocopied.
    </h2>
    <p class="cover-sub">
      A zine about code, cities and other fixations — printed in two inks on cream stock.
      <Doodles kind="scribble" width={120} />
    </p>
    <nav class="cover-nav" aria-label="Sections">
      {
        rows.map((r) => (
          <a class="row" href={r.href}>
            <span class="label">{r.label}</span>
            <span class="hint">{r.hint}</span>
            <Doodles kind="arrow" width={56} />
          </a>
        ))
      }
    </nav>
  </div>
  <Ticker
    items={[
      'Issue No. 001',
      'Fresh ink',
      'No trackers, no cookies',
      'RSS at /rss.xml',
      'Writing at /writing/',
      'Made with paper, ink + Astro',
    ]}
  />
</BaseLayout>
