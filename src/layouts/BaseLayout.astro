---
import '@fontsource/big-shoulders-display/400';
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/newsreader/400';
import '@fontsource/newsreader/400-italic';
import '@fontsource/newsreader/500';
import '@fontsource/newsreader/700';
import '@fontsource/courier-prime/400';
import '@fontsource/courier-prime/400-italic';
import '@fontsource/courier-prime/700';
import display900 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2';
import newsreader400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2';
import '../styles/global.css';
import '../styles/experience.css';

import Nav from '../components/Nav.astro';
import Grain from '../components/Grain.astro';
import CropMarks from '../components/CropMarks.astro';
import Barcode from '../components/Barcode.astro';
import { u } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A risograph zine about code, cities and other fixations — by Joe Rourke.' } =
  Astro.props;
const pageTitle = title === 'Home' ? 'Joe Rourke — a two-ink zine' : `${title} — Joe Rourke`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <!-- printed by hand in two inks — joerourke.co.uk, issue no. 001 -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preload" href={display900} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreader400} as="font" type="font/woff2" crossorigin />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23F4F1EA'/%3E%3Crect x='5' y='5' width='22' height='22' fill='%23FF6C2F' stroke='%231B1B1B' stroke-width='3'/%3E%3C/svg%3E"
    />
    <link rel="alternate" type="application/rss+xml" title="Joe Rourke — Writing" href={u('/rss.xml')} />
  </head>
  <body data-base={import.meta.env.BASE_URL}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="inkbar" aria-hidden="true"></div>
    <div class="roller" aria-hidden="true"></div>
    <CropMarks />
    <Grain />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <div>
          <p class="mono">Joe Rourke — Issue no. 001</p>
          <p class="note">
            Set in Big Shoulders Display, Newsreader &amp; Courier Prime. Printed in two inks on cream
            stock. No trackers, no cookies, no analytics — the only browser storage is on-device
            localStorage for your copy no., page stamps and reading position. Nothing is transmitted.
          </p>
          <div class="stampstrip" id="stampstrip" aria-label="Pages you have visited">
            <span class="count mono" id="stampcount"></span>
          </div>
        </div>
        <div>
          <p class="mono">
            <a href={u('/rss.xml')}>RSS</a> /// <a href={u('/colophon/')}>Colophon</a> ///
            <a href="https://github.com/JoeRourke123/joerourke.co.uk">Source</a>
          </p>
          <Barcode seed="JOEROURKE-001" />
        </div>
      </div>
    </footer>
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
    <script>
      console.log(
        '%cJOE ROURKE — ISSUE NO. 001%cset by hand in two inks. view-source is the zine.',
        'background:#FF6C2F;color:#1B1B1B;font-weight:bold;padding:4px 8px;',
        'color:#0078BF;',
      );
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      const els = document.querySelectorAll('.reveal');
      if (!mq.matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
      try {
        const KEY = 'jr-memory-v1';
        const mem = JSON.parse(localStorage.getItem(KEY) || '{}');
        mem.visits = (mem.visits || 0) + 1;
        mem.pages = mem.pages || {};
        mem.pages[location.pathname] = true;
        localStorage.setItem(KEY, JSON.stringify(mem));
        const copy = document.getElementById('copyno');
        if (copy) copy.textContent = 'copy no. ' + mem.visits;
        const strip = document.getElementById('stampstrip');
        if (strip) {
          const paths = Object.keys(mem.pages).sort();
          const squares = paths
            .map((p) => '<span class="st seen" title="' + p + '"></span>')
            .join('');
          const count = document.getElementById('stampcount');
          if (count) count.textContent = paths.length + (paths.length === 1 ? ' page seen' : ' pages seen');
          strip.insertAdjacentHTML('afterbegin', squares);
        }
        const art = document.querySelector('article[data-slug]');
        if (art) {
          const slug = art.getAttribute('data-slug') || '';
          const h1 = art.querySelector('h1');
          const title = h1 && h1.textContent ? h1.textContent.trim() : slug;
          const save = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const pct = max > 0 ? Math.round((window.scrollY / max) * 100) : 100;
            mem.progress = mem.progress || {};
            if (pct >= 5 && pct < 100) mem.progress[slug] = { pct, title };
            else delete mem.progress[slug];
            localStorage.setItem(KEY, JSON.stringify(mem));
          };
          let t;
          window.addEventListener('scroll', () => { clearTimeout(t); t = setTimeout(save, 300); }, { passive: true });
          save();
        }
        const cont = document.getElementById('continue');
        if (cont && mem.progress) {
          const entries = Object.entries(mem.progress)
            .filter(([, v]) => v.pct >= 5 && v.pct < 100)
            .sort((a, b) => b[1].pct - a[1].pct);
          if (entries.length) {
            const slug = entries[0][0];
            const v = entries[0][1];
            const base = document.body.dataset.base || '/';
            const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            cont.innerHTML =
              '<a class="post-card" href="' + base + 'writing/' + esc(slug) + '/">' +
              '<div class="meta"><span>ink stain at ' + v.pct + '%</span></div>' +
              '<h2>Continue: ' + esc(v.title) + '</h2>' +
              '<p class="desc">You left a bookmark in this one.</p></a>';
          }
        }
      } catch (e) {}
    </script>
  </body>
</html>
