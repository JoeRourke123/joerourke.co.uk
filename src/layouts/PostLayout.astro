---
import BaseLayout from './BaseLayout.astro';
import { render } from 'astro:content';
import type { Post } from '../utils/posts';
import { readingTime, wordCount, formatDate } from '../utils/posts';
import { u } from '../utils/url';

// DESIGN.md §18: themes are auto-discovered; unknown theme = build error.
const themeModules = import.meta.glob('../themes/*/Theme.astro', { eager: true }) as Record<
  string,
  { default: (_props: { children?: unknown }) => unknown }
>;

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);

const themeKey = post.data.theme ? `../themes/${post.data.theme}/Theme.astro` : undefined;
const Theme = themeKey ? themeModules[themeKey]?.default : undefined;
if (post.data.theme && !Theme) {
  throw new Error(`Unknown post theme "${post.data.theme}" — expected src/themes/${post.data.theme}/Theme.astro`);
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container" data-theme={post.data.theme}>
    <header class="post-head">
      <div class="meta">
        <span>{formatDate(post.data.date)}</span>
        <span>{readingTime(post.body ?? '')} min read</span>
        <span>{wordCount(post.body ?? '')} words</span>
        {post.data.tags.map((t) => <a class="tag-chip" href={u(`/writing/tag/${t}/`)}>{t}</a>)}
      </div>
      <h1 class="misreg" data-text={post.data.title}>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="post-body">
      {Theme ? <Theme><Content /></Theme> : <Content />}
    </div>
    <footer class="post-foot">
      <a href={u('/writing/')}>← All writing</a>
      <span class="mono">Filed under {post.data.tags.join(', ') || 'miscellaneous'}</span>
    </footer>
  </article>
</BaseLayout>
